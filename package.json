{
  "name": "kobayashi-maru",
  "version": "1.0.0",
  "description": "Kobayashi Maru - Endless Simulation / God Game Tower Defense",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:update": "playwright test --config e2e/playwright.config.ts --update-snapshots"
  },
  "keywords": [
    "game",
    "simulation",
    "tower-defense",
    "pixijs",
    "ecs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bitecs": "0.4.0",
    "gl-matrix": "^3.4.4",
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
